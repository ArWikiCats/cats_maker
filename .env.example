# ==============================================================================
# Cats Maker Bot - Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application & Logging Settings
# ------------------------------------------------------------------------------
# Application environment: development | production | testing
APP_ENV=development

# Enable or disable global debug mode (true/false)
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path for the bot's detailed execution log file
CATS_MAKER_LOG_FILE=~/BOTS_LOGS/cats_maker_new.log

# Maximum iteration depth or range limit for category processing
RANGE_LIMIT=5


# ------------------------------------------------------------------------------
# 2. Wikipedia Configuration & Credentials
# ------------------------------------------------------------------------------
# Bot authentication credentials
WIKIPEDIA_BOT_USERNAME=your_bot_username
WIKIPEDIA_BOT_PASSWORD=your_bot_password

# Primary Arabic target site configuration
WIKIPEDIA_AR_FAMILY=wikipedia
WIKIPEDIA_AR_CODE=ar

# Primary English source site configuration
WIKIPEDIA_EN_FAMILY=wikipedia
WIKIPEDIA_EN_CODE=en

# Custom HTTP User-Agent header (defaults automatically if left empty)
WIKIPEDIA_USER_AGENT=

# Timeout in seconds for standard Wikipedia API requests
WIKIPEDIA_TIMEOUT=10


# ------------------------------------------------------------------------------
# 3. Wikidata Configuration
# ------------------------------------------------------------------------------
# Main API endpoint for Wikidata
WIKIDATA_ENDPOINT=https://www.wikidata.org/w/api.php

# SPARQL query service endpoint
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql

# Timeout in seconds for Wikidata API requests
WIKIDATA_TIMEOUT=30

# Maximum database lag threshold allowed in seconds
WIKIDATA_MAXLAG=5


# ------------------------------------------------------------------------------
# 4. API Client Settings
# ------------------------------------------------------------------------------
# Maximum retry attempts for failed HTTP/API calls
API_CLIENT_MAX_RETRIES=5

# Exponential backoff base delay in seconds
API_CLIENT_BACKOFF_BASE=1

# HTTP response header name used for retry handling on maxlag error
API_CLIENT_MAXLAG_HEADER=Retry-After

# ------------------------------------------------------------------------------
# 5. Database & Replica Server Configuration
# ------------------------------------------------------------------------------
# Standard database credentials and connections (e.g., Toolforge DB replicas)
DATABASE_HOST=
DATABASE_PORT=3306
TOOL_REPLICA_USER=
TOOL_REPLICA_PASSWORD=

# Enable SQL queries instead of API fallbacks (true/false)
DATABASE_USE_SQL=true

# Cache Time-To-Live in seconds (Default: 604800 = 7 days)
TOOL_REPLICA_CACHE_TTL=604800

# ------------------------------------------------------------------------------
# 6. Category Processing Settings
# ------------------------------------------------------------------------------
# Minimum number of category members required before creating a new category
MIN_MEMBERS=10


# ------------------------------------------------------------------------------
# 7. Local File Paths & Directories
# ------------------------------------------------------------------------------
# Project root directory
PROJECT_PATH=/data/project/himo

# Directory path for storing session cookies
COOKIES_DIR=

# Path to local JSON file containing blacklisted pages/categories
DONT_ADD_TO_PAGES_PATH=~/textfiles/Dont_add_to_pages.json

# Optional: Path to ArWikiCats repository/module (for local development)
# ARWIKICATS_PATH=/path/to/ArWikiCats
